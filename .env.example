# Copy to .env and replace every change-me value. Generate secrets with: openssl rand -hex 32
# Never commit .env. Only this file (names + placeholders) is tracked.

# ---------- Database (docker-compose "db") ----------
# PostgreSQL superuser created on first container start
POSTGRES_USER=campusspace
# Password for POSTGRES_USER (hex only, so it is safe inside postgresql:// URLs)
POSTGRES_PASSWORD=change-me
# Database created on first container start
POSTGRES_DB=campusspace
# Host port mapped to the container's 5432
POSTGRES_PORT=5432

# ---------- ASP.NET Core API (locally prefer dotnet user-secrets for these) ----------
# Npgsql connection string used by AppDbContext
ConnectionStrings__Default=Host=localhost;Port=5432;Database=campusspace;Username=campusspace;Password=change-me
# HMAC signing key for JWTs (64 hex chars)
Jwt__Key=change-me
# JWT issuer claim
Jwt__Issuer=campusspace-api
# JWT audience claim
Jwt__Audience=campusspace-clients

# ---------- Agent service ----------
# Base URL the API uses to call the LangGraph agent service
AgentService__BaseUrl=http://localhost:8000
# Shared key sent by the API to the agent service as X-Service-Key (>= 32 chars; must differ from AgentTools__Key)
AgentService__ServiceKey=change-me
# Shared key sent by agent tools to /internal/agent-tools/... as X-Agent-Key (>= 32 bytes, checked at API and
# agent-service startup; generate it separately from AgentService__ServiceKey: openssl rand -hex 32)
AgentTools__Key=change-me
# Base URL the agent service's tools call (/internal/agent-tools/...)
API_BASE_URL=http://localhost:5080
# Optional: the agent service's LangGraph SqliteSaver file (default agent-service/data/checkpoints.sqlite,
# git-ignored). Paused approvals live here, so keep it on a persistent disk.
AGENT_CHECKPOINT_PATH=
# Google AI Studio key for Gemini (the name langchain-google-genai reads). Required only when AGENT_LLM_AGENTS
# enables an agent; not used by .NET. Never print, log or commit it.
GOOGLE_API_KEY=
# Comma list of agents that call Gemini: supervisor (Task 4.1), venue_matching (4.2); equipment_allocation
# and policy_cost once 4.3-4.4 land. Empty (the default, and CI) = every agent is a deterministic stub.
AGENT_LLM_AGENTS=
# Optional Gemini model ids (empty = the defaults: gemini-3.5-flash for planning, gemini-3.5-flash-lite
# for workers; the labs' 2.5 ids are refused for new Google AI Studio accounts)
PLANNER_MODEL=
WORKER_MODEL=
# Optional Gemini 3 thinking levels: minimal | low | medium | high (empty = planner low, workers minimal;
# lower means faster and fewer output tokens)
PLANNER_THINKING=
WORKER_THINKING=

# ---------- Email ----------
# API key for the transactional email provider (component B)
Email__ApiKey=

# ---------- Clients ----------
# API base URL the React app calls (Vite exposes VITE_* vars to the browser)
VITE_API_URL=http://localhost:5080
# API base URL for Flutter via --dart-define (Android emulator: http://10.0.2.2:5080)
API_URL=http://localhost:5080
