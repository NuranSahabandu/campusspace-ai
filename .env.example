# Copy to .env and replace every change-me value. Generate secrets with: openssl rand -hex 32
# Never commit .env. Only this file (names + placeholders) is tracked.

# ---------- Database (docker-compose "db") ----------
# PostgreSQL superuser created on first container start
POSTGRES_USER=campusspace
# Password for POSTGRES_USER (hex only, so it is safe inside postgresql:// URLs)
POSTGRES_PASSWORD=change-me
# Database created on first container start
POSTGRES_DB=campusspace
# Host port mapped to the container's 5432
POSTGRES_PORT=5432

# ---------- ASP.NET Core API (locally prefer dotnet user-secrets for these) ----------
# Npgsql connection string used by AppDbContext
ConnectionStrings__Default=Host=localhost;Port=5432;Database=campusspace;Username=campusspace;Password=change-me
# HMAC signing key for JWTs (64 hex chars)
Jwt__Key=change-me
# JWT issuer claim
Jwt__Issuer=campusspace-api
# JWT audience claim
Jwt__Audience=campusspace-clients

# ---------- Agent service ----------
# Base URL the API uses to call the LangGraph agent service
AgentService__BaseUrl=http://localhost:8000
# Shared key sent by the API to the agent service as X-Service-Key
AgentService__ServiceKey=change-me
# Shared key sent by agent tools to /internal/agent-tools/... as X-Agent-Key
AgentTools__Key=change-me
# Google Gemini API key used by the agent service LLM calls
GOOGLE_API_KEY=

# ---------- Email ----------
# API key for the transactional email provider (component B)
Email__ApiKey=

# ---------- Clients ----------
# API base URL the React app calls (Vite exposes VITE_* vars to the browser)
VITE_API_URL=http://localhost:5080
# API base URL for Flutter via --dart-define (Android emulator: http://10.0.2.2:5080)
API_URL=http://localhost:5080
