<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: this overlay is merged into the debug APK, never into release.
         The config allows plain HTTP to the local API (10.0.2.2 / localhost); everything else,
         and the whole release build, stays HTTPS-only (Android 9+ default). -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
