{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "campusspace-api",
    "Audience": "campusspace-clients",
    "AccessTokenMinutes": 120
  },
  "Database": {
    "MigrateOnStartup": false,
    "RequireSsl": false
  },
  "Seed": {
    "OnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Storage": {
    "DamagePhotosPath": "App_Data/damage-photos"
  },
  "AgentService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Email": {
    "FromName": "CampusSpace AI",
    "BaseUrl": "https://api.brevo.com/v3/",
    "PollSeconds": 5
  },
  "AllowedHosts": "*"
}
