{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": null,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss zzz} {Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": { "MigrateOnStartup": false, "RequireSsl": true },
  "Seed": { "OnStartup": true },
  "Swagger": { "Enabled": true },
  "ForwardedHeaders": { "Enabled": true },
  "https_port": 443
}
